<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --harvest-soil: #6b4f35;
            --harvest-leaf: #1f6f4a;
            --harvest-cream: #fff9ee;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: radial-gradient(circle at 20% 20%, #ffeec6 0%, #f4c98d 40%, #d9a86e 100%);
            color: #2b2118;
        }

        .shell {
            max-width: 1600px;
            margin: 0 auto;
            padding: 24px 8px 36px;
        }

        .hero {
            background: linear-gradient(140deg, rgba(255, 252, 245, 0.95), rgba(255, 245, 223, 0.95));
            border: 1px solid rgba(107, 79, 53, 0.15);
            border-radius: 18px;
            box-shadow: 0 8px 30px rgba(66, 38, 17, 0.13);
            padding: 24px;
            margin-bottom: 16px;
        }

        .hero h1 {
            margin: 0 0 6px;
            color: var(--harvest-soil);
            font-weight: 700;
        }

        .hero p {
            margin: 0 0 12px;
            color: #5e4938;
        }

        .stat-row {
            display: flex;
            gap: 16px;
            margin-top: 12px;
            flex-wrap: wrap;
        }

        .stat-badge {
            background: rgba(31, 111, 74, 0.1);
            border: 1px solid rgba(31, 111, 74, 0.3);
            border-radius: 8px;
            padding: 8px 14px;
            font-size: 0.9rem;
        }

        .stat-badge strong {
            color: var(--harvest-leaf);
            font-weight: 700;
        }

        .card-harvest {
            background: var(--harvest-cream);
            border: 1px solid rgba(107, 79, 53, 0.16);
            border-radius: 14px;
            padding: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
            margin-bottom: 14px;
        }

        .table {
            --bs-table-bg: transparent;
            margin-bottom: 0;
        }

        .table-header {
            background: rgba(31, 111, 74, 0.08);
            font-weight: 600;
            color: var(--harvest-soil);
            font-size: 0.85rem;
            text-transform: uppercase;
            letter-spacing: 0.03em;
        }

        .mono {
            font-family: Consolas, 'Courier New', monospace;
            font-size: 0.88rem;
        }

        .status-confirmed {
            background: #d7f3e4;
            color: #155b3b;
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-block;
        }

        .status-unconfirmed {
            background: #ffe0d5;
            color: #7e2f14;
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
            display: inline-block;
        }

        .table-scroll {
            max-height: 1200px;
            overflow-y: auto;
            border: 1px solid rgba(107, 79, 53, 0.14);
            border-radius: 10px;
            background: #fffdf8;
        }

        .table-scroll table {
            margin-bottom: 0;
        }

        .table-scroll thead {
            position: sticky;
            top: 0;
            z-index: 10;
        }

        .control-bar {
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 12px;
            margin-bottom: 12px;
            flex-wrap: wrap;
        }

        .search-input {
            flex: 1;
            min-width: 200px;
            max-width: 400px;
        }

        .filter-controls {
            display: flex;
            gap: 8px;
        }

        .btn-harvest {
            background: var(--harvest-leaf);
            border: none;
            color: white;
        }

        .btn-harvest:hover {
            background: #195a3c;
            color: white;
        }

        .dim-text {
            color: #8b7a68;
            font-size: 0.85rem;
        }

        .action-cell {
            white-space: nowrap;
            text-align: center;
        }

        .btn-confirm {
            font-size: 0.75rem;
            padding: 0.25rem 0.5rem;
        }

        .modal-body input {
            font-size: 0.95rem;
            margin-bottom: 12px;
            background-color: #fff;
            color: #2b2118;
            border: 1px solid #ccc;
            padding: 8px 12px;
            border-radius: 4px;
        }

        .modal-body input:focus {
            background-color: #fff;
            color: #2b2118;
            border-color: #1f6f4a;
            outline: none;
            box-shadow: 0 0 0 3px rgba(31, 111, 74, 0.1);
        }

        .matching-items {
            background: #f8f5f0;
            border: 1px solid rgba(107, 79, 53, 0.2);
            border-radius: 8px;
            padding: 12px;
            margin: 12px 0;
            max-height: 300px;
            overflow-y: auto;
        }

        .matching-item {
            font-size: 0.85rem;
            padding: 6px 0;
            border-bottom: 1px solid rgba(107, 79, 53, 0.1);
        }

        .matching-item:last-child {
            border-bottom: none;
        }

        .use-confirmed-btn {
            font-weight: 600;
            white-space: nowrap;
        }

        .alert-success .mono {
            background: rgba(255, 255, 255, 0.5);
            padding: 2px 4px;
            border-radius: 3px;
            font-size: 0.85rem;
        }

        .invalid-upc {
            background-color: #ffe0d5;
            color: #7e2f14;
            font-weight: 600;
            padding: 2px 6px;
            border-radius: 4px;
        }

        .upc-cell {
            position: relative;
        }

        .upc-warning {
            display: inline-block;
            margin-left: 4px;
            font-size: 0.75rem;
            color: #dc3545;
            font-weight: bold;
        }

        @media (max-width: 900px) {
            .control-bar {
                flex-direction: column;
                align-items: stretch;
            }

            .search-input {
                max-width: 100%;
            }

            .table-scroll {
                font-size: 0.9rem;
            }
        }
    </style>
</head>
<body>
    <main class="shell">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h2 class="mb-1">Harvest Dashboard</h2>
                <div class="text-muted">All Products from Intake Documents</div>
            </div>
            <div class="d-flex gap-2">
                <a class="btn btn-outline-secondary" href="/harvest/dashboard">Back to Dashboard</a>
            </div>
        </div>

        <section class="card-harvest">
            <div class="hero">
                <h1>All Products Catalog</h1>
                <p>Complete list of all items extracted from harvest intake documents, sorted by product description.</p>
                <div class="stat-row">
                    <div class="stat-badge">
                        Total: <strong><%= totalProducts %></strong> items
                    </div>
                    <div class="stat-badge">
                        Confirmed: <strong><%= confirmedCount %></strong>
                    </div>
                    <div class="stat-badge">
                        Unconfirmed: <strong><%= unconfirmedCount %></strong>
                    </div>
                </div>
            </div>

            <div class="control-bar">
                <input 
                    type="text" 
                    class="form-control search-input" 
                    id="productSearch" 
                    placeholder="Search by product name, UPC, SKU, or acknowledgement #..."
                >
                <div class="filter-controls">
                    <button class="btn btn-sm btn-outline-secondary" id="filterAll" data-filter="">All</button>
                    <button class="btn btn-sm btn-outline-success" id="filterConfirmed" data-filter="confirmed">Confirmed</button>
                    <button class="btn btn-sm btn-outline-warning" id="filterUnconfirmed" data-filter="unconfirmed">Unconfirmed</button>
                    <button class="btn btn-sm btn-outline-danger" id="filterInvalidUpc" data-filter="invalid-upc">Invalid UPCs (≠12)</button>
                </div>
            </div>

            <div class="table-scroll">
                <table class="table table-sm table-hover" id="productsTable">
                    <thead class="table-header">
                        <tr>
                            <th>Product</th>
                            <th>UPC</th>
                            <th>SKU</th>
                            <th class="text-end">Qty Ordered</th>
                            <th class="text-end">Qty Received</th>
                            <th>Acknowledgement #</th>
                            <th>Status</th>
                            <th class="action-cell">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% products.forEach((product, index) => { %>
                            <tr class="product-row" data-product="<%= (product.product || '').toLowerCase() %>" data-upc="<%= (product.upc || '').toLowerCase() %>" data-sku="<%= (product.sku || '').toLowerCase() %>" data-ack="<%= (product.acknowledgementNumber || '').toLowerCase() %>" data-status="<%= product.isConfirmed ? 'confirmed' : 'unconfirmed' %>" data-index="<%= index %>">
                                <td><%= product.product || '-' %></td>
                                <td class="upc-cell">
                                    <% const upcLength = (product.upc || '').length; %>
                                    <% const isInvalidUpc = product.upc && upcLength !== 12; %>
                                    <span class="mono <%= isInvalidUpc ? 'invalid-upc' : '' %>">
                                        <%= product.upc || '-' %>
                                        <% if (isInvalidUpc) { %>
                                            <span class="upc-warning" title="UPC should be 12 digits, this has <%= upcLength %>">⚠</span>
                                        <% } %>
                                    </span>
                                </td>
                                <td class="mono"><%= product.sku || '-' %></td>
                                <td class="text-end"><%= product.qtyOrdered %></td>
                                <td class="text-end"><%= product.qtyReceived %></td>
                                <td class="mono"><%= product.acknowledgementNumber %></td>
                                <td>
                                    <% if (product.isConfirmed) { %>
                                        <span class="status-confirmed">Confirmed</span>
                                    <% } else { %>
                                        <span class="status-unconfirmed">Unconfirmed</span>
                                    <% } %>
                                </td>
                                <td class="action-cell">
                                    <button class="btn btn-sm btn-outline-primary btn-confirm" 
                                        data-index="<%= index %>" 
                                        type="button" 
                                        data-bs-toggle="modal" 
                                        data-bs-target="#editConfirmModal">Edit</button>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>

            <div class="mt-2 dim-text">
                Displaying <%= products.length %> items sorted by product description (ascending)
            </div>
        </section>
    </main>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        // Wait for DOM to load
        document.addEventListener('DOMContentLoaded', function() {
            console.log('DOM fully loaded');

            const searchInput = document.getElementById('productSearch');
            const filterButtons = document.querySelectorAll('[id^="filter"]');
            const rows = document.querySelectorAll('.product-row');

            let currentFilter = localStorage.getItem('harvestProductsFilter') || '';
            let products = <%- JSON.stringify(products) %>;
            let selectedProductIndex = null;
            let originalProduct = null;

            console.log('Products loaded:', products.length, 'items');
            console.log('Restored filter from localStorage:', currentFilter || 'All');

            // Function to scroll to next unconfirmed item
            function scrollToNextUnconfirmed() {
                const unconfirmedRows = Array.from(rows).filter(row => {
                    const status = row.dataset.status;
                    const isVisible = row.style.display !== 'none';
                    return status === 'unconfirmed' && isVisible;
                });

                if (unconfirmedRows.length > 0) {
                    const nextRow = unconfirmedRows[0];
                    // Highlight the row briefly
                    nextRow.style.background = '#fff4dc';
                    nextRow.scrollIntoView({ behavior: 'smooth', block: 'center' });
                    
                    // Remove highlight after 2 seconds
                    setTimeout(() => {
                        nextRow.style.background = '';
                    }, 2000);
                    
                    return true;
                }
                return false;
            }

            // Check if we should scroll to next unconfirmed on page load
            // DISABLED: Auto-scroll was skipping items with wrong UPCs
            // const urlParams = new URLSearchParams(window.location.search);
            // if (urlParams.get('scrollToNext') === 'true') {
            //     setTimeout(() => {
            //         scrollToNextUnconfirmed();
            //     }, 200);
            // }

            function filterTable() {
                const searchTerm = searchInput.value.toLowerCase();

                rows.forEach(row => {
                    const product = row.dataset.product || '';
                    const upc = row.dataset.upc || '';
                    const sku = row.dataset.sku || '';
                    const ack = row.dataset.ack || '';
                    const status = row.dataset.status || '';

                    const matchesSearch = !searchTerm || 
                        product.includes(searchTerm) || 
                        upc.includes(searchTerm) || 
                        sku.includes(searchTerm) || 
                        ack.includes(searchTerm);

                    let matchesFilter = true;
                    if (currentFilter === 'invalid-upc') {
                        // Show only items with UPCs that are not 12 digits
                        const upcLength = upc.length;
                        matchesFilter = upc && upcLength !== 12;
                    } else {
                        matchesFilter = !currentFilter || status === currentFilter;
                    }

                    row.style.display = matchesSearch && matchesFilter ? '' : 'none';
                });
            }

            searchInput.addEventListener('input', filterTable);

            filterButtons.forEach(btn => {
                btn.addEventListener('click', () => {
                    filterButtons.forEach(b => b.classList.remove('active'));
                    btn.classList.add('active');
                    currentFilter = btn.dataset.filter;
                    localStorage.setItem('harvestProductsFilter', currentFilter);
                    filterTable();
                });
            });

            // Restore filter state and set active button
            if (currentFilter) {
                const activeBtn = document.querySelector(`[data-filter="${currentFilter}"]`);
                if (activeBtn) {
                    activeBtn.classList.add('active');
                }
            } else {
                document.getElementById('filterAll').classList.add('active');
            }
            filterTable();

            // Edit/Confirm modal handling
            const editConfirmModal = document.getElementById('editConfirmModal');
            console.log('Modal element:', editConfirmModal);
            
            if (!editConfirmModal) {
                console.error('Modal element not found!');
                return;
            }

            const productInput = document.getElementById('editProduct');
            const upcInput = document.getElementById('editUpc');
            const skuInput = document.getElementById('editSku');
            const matchingContainer = document.getElementById('matchingItems');

            console.log('Input elements found - Product:', productInput, 'UPC:', upcInput, 'SKU:', skuInput, 'Matching:', matchingContainer);
            
            // Listen for modal show event to populate fields
            editConfirmModal.addEventListener('show.bs.modal', function(e) {
                const btn = e.relatedTarget;
                console.log('Modal show event fired, button:', btn);
                
                if (!btn) {
                    console.warn('No button found');
                    return;
                }

                const index = parseInt(btn.dataset.index, 10);
                console.log('Index from button:', index);
                console.log('Products array length:', products.length);

                if (index >= 0 && index < products.length) {
                    const product = products[index];
                    console.log('Found product:', product);
                    
                    selectedProductIndex = index;
                    originalProduct = { ...product }; // Store original values for comparison

                    // Set input values
                    productInput.value = product.product || '';
                    upcInput.value = product.upc || '';
                    skuInput.value = product.sku || '';

                    console.log('Set values - Product:', productInput.value, 'UPC:', upcInput.value, 'SKU:', skuInput.value);

                    // Show confirmation status
                    let statusHtml = '';
                    if (product.isConfirmed) {
                        statusHtml = `
                            <div class="alert alert-success mb-3">
                                <strong>✓ This item is already CONFIRMED</strong><br>
                                <small>You can update the Product, UPC, or SKU to fix errors. All matching items will be updated.</small>
                            </div>
                        `;
                    } else {
                        statusHtml = `
                            <div class="alert alert-warning mb-3">
                                <strong>⚠ This item is UNCONFIRMED</strong><br>
                                <small>You need to confirm it to mark it as valid.</small>
                            </div>
                        `;
                    }

                    // Add status to the beginning of matching container
                    let allContent = statusHtml;

                    // Check if this is an unconfirmed product with confirmed matches
                    let confirmedMatches = [];
                    if (!product.isConfirmed) {
                        confirmedMatches = products.filter((p, i) => {
                            if (i === index) return false;
                            if (!p.isConfirmed) return false;
                            // Match by product name
                            return (product.product && p.product && p.product.toLowerCase() === product.product.toLowerCase());
                        });
                    }

                    console.log('Confirmed matches found:', confirmedMatches.length);

                    // Display confirmed matches if found
                    if (confirmedMatches.length > 0) {
                        allContent += `
                            <div class="alert alert-success mb-3">
                                <h6 class="mb-2">✓ Found ${confirmedMatches.length} Confirmed Match(es)</h6>
                                <p class="mb-2 small">Click <strong>"Use UPC/SKU"</strong> to auto-fill this form from a confirmed version:</p>
                                ${confirmedMatches.map((m, idx) => `
                                    <div class="card mb-2" style="background: #f0f8f5; border: 1px solid #1f6f4a;">
                                        <div class="card-body p-2">
                                            <div class="d-flex justify-content-between align-items-start gap-2">
                                                <div style="flex: 1;">
                                                    <strong class="d-block">${m.product}</strong>
                                                    <small class="text-muted d-block">UPC: <span class="mono">${m.upc || '-'}</span></small>
                                                    <small class="text-muted d-block">SKU: <span class="mono">${m.sku || '-'}</span></small>
                                                    <small class="text-muted d-block">From: ${m.acknowledgementNumber}</small>
                                                </div>
                                                <button class="btn btn-sm btn-success use-confirmed-btn" data-confirmed-index="${idx}" type="button">
                                                    Use UPC/SKU
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                `).join('')}
                            </div>
                        `;
                    }

                    // Find matching items (both confirmed and unconfirmed)
                    const matchingItems = products.filter((p, i) => {
                        if (i === index) return false;
                        return (
                            (product.product && p.product && p.product.toLowerCase() === product.product.toLowerCase()) ||
                            (product.upc && p.upc && p.upc === product.upc) ||
                            (product.sku && p.sku && p.sku === product.sku)
                        );
                    });

                    console.log('Found matching items:', matchingItems.length);

                    if (matchingItems.length > 0) {
                        allContent += `
                            <div class="alert alert-info">
                                <strong>These ${matchingItems.length} other item(s) will ALSO be ${product.isConfirmed ? 'updated' : 'confirmed'}</strong>
                                <p class="small text-muted mb-2">Each keeps its own Acknowledgement #:</p>
                                <div class="matching-items">
                                    ${matchingItems.map(m => `
                                        <div class="matching-item">
                                            <strong>${m.product}</strong><br>
                                            <small>
                                                UPC: ${m.upc} | SKU: ${m.sku}<br>
                                                Ack: <strong class="mono">${m.acknowledgementNumber}</strong> (unchanged)
                                            </small>
                                            <span class="badge ${m.isConfirmed ? 'bg-success' : 'bg-warning'} ms-2">
                                                ${m.isConfirmed ? 'Already Confirmed' : 'Will be Confirmed'}
                                            </span>
                                        </div>
                                    `).join('')}
                                </div>
                            </div>
                        `;
                    } else {
                        allContent += '<p class="text-muted small">No other matching items found. Only this item will be ' + (product.isConfirmed ? 'updated' : 'confirmed') + '.</p>';
                    }

                    matchingContainer.innerHTML = allContent;

                    // Attach click handlers to "Use UPC/SKU" buttons
                    const useConfirmedBtns = matchingContainer.querySelectorAll('.use-confirmed-btn');
                    useConfirmedBtns.forEach(btn => {
                        btn.addEventListener('click', () => {
                            const confirmedIdx = parseInt(btn.dataset.confirmedIndex, 10);
                            const confirmedProduct = confirmedMatches[confirmedIdx];
                            
                            // Auto-fill form with confirmed product data
                            productInput.value = confirmedProduct.product || '';
                            upcInput.value = confirmedProduct.upc || '';
                            skuInput.value = confirmedProduct.sku || '';
                            
                            console.log('Copied from confirmed:', confirmedProduct);
                            
                            // Scroll to top of modal to show updated fields
                            matchingContainer.scrollIntoView({ behavior: 'smooth', block: 'start' });
                        });
                    });

                } else {
                    console.error('Invalid index:', index);
                }
            });

            // Confirm button in modal
            const confirmBtn = document.getElementById('confirmProductBtn');
            if (confirmBtn) {
                confirmBtn.addEventListener('click', async () => {
                    if (selectedProductIndex === null || !originalProduct) {
                        alert('No product selected');
                        return;
                    }

                    // Get the current (possibly edited) values from the input fields
                    const description = document.getElementById('editProduct').value.trim();
                    const upc = document.getElementById('editUpc').value.trim();
                    const sku = document.getElementById('editSku').value.trim();

                    if (!description && !upc && !sku) {
                        alert('Please enter at least a product description, UPC, or SKU');
                        return;
                    }

                    const isConfirmed = originalProduct.isConfirmed;
                    const endpoint = isConfirmed ? '/harvest/products/update-confirmed' : '/harvest/products/confirm';

                    let requestBody;
                    // Always send old and new values so backend can find items by old values
                    // then update them to new values and confirm
                    requestBody = {
                        oldDescription: originalProduct.product,
                        oldUpc: originalProduct.upc,
                        oldSku: originalProduct.sku,
                        newDescription: description,
                        newUpc: upc,
                        newSku: sku
                    };

                    try {
                        const response = await fetch(endpoint, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(requestBody)
                        });

                        const result = await response.json();
                        if (result.success) {
                            const count = result.confirmedCount || result.updatedCount;
                            alert(`Confirmed ${count} item(s)`);
                            
                            // Close modal and reload with scroll parameter
                            const modal = bootstrap.Modal.getInstance(editConfirmModal);
                            if (modal) modal.hide();

                            // Reload page to refresh data
                            setTimeout(() => {
                                window.location.reload();
                            }, 300);
                        } else {
                            alert('Error: ' + (result.error || 'Unknown error'));
                        }
                    } catch (error) {
                        console.error('Confirm/Update error:', error);
                        alert('Error: ' + error.message);
                    }
                });

                // Update button text based on modal content
                editConfirmModal.addEventListener('show.bs.modal', function(e) {
                    setTimeout(() => {
                        if (originalProduct) {
                            if (originalProduct.isConfirmed) {
                                confirmBtn.textContent = 'Update All Matching Items';
                                confirmBtn.className = 'btn btn-warning';
                            } else {
                                confirmBtn.textContent = 'Confirm All Matching Items';
                                confirmBtn.className = 'btn btn-harvest';
                            }
                        }
                    }, 100);
                });
            }
        });
    </script>

    <!-- Edit/Confirm Modal -->
    <div class="modal fade" id="editConfirmModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Confirm & Link Product</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <div class="alert alert-warning mb-3">
                        <strong>⚠ Important:</strong> The Acknowledgement # will NOT be changed. Only Product, UPC, and SKU are being updated.
                    </div>

                    <div class="mb-3">
                        <label for="editProduct" class="form-label">Product Description</label>
                        <input type="text" class="form-control" id="editProduct">
                    </div>
                    <div class="mb-3">
                        <label for="editUpc" class="form-label">UPC</label>
                        <input type="text" class="form-control mono" id="editUpc">
                    </div>
                    <div class="mb-3">
                        <label for="editSku" class="form-label">SKU</label>
                        <input type="text" class="form-control mono" id="editSku">
                    </div>
                    <div id="matchingItems"></div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                    <button type="button" class="btn btn-harvest" id="confirmProductBtn">Confirm All Matching Items</button>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
