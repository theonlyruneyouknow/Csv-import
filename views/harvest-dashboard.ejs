<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --harvest-soil: #6b4f35;
            --harvest-leaf: #1f6f4a;
            --harvest-straw: #f6ddb0;
            --harvest-cream: #fff9ee;
            --harvest-warn: #b2411d;
        }

        body {
            min-height: 100vh;
            margin: 0;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: radial-gradient(circle at 20% 20%, #ffeec6 0%, #f4c98d 40%, #d9a86e 100%);
            color: #2b2118;
        }

        .shell {
            max-width: 1600px;
            margin: 0 auto;
            padding: 24px 8px 36px;
        }

        .hero {
            background: linear-gradient(140deg, rgba(255, 252, 245, 0.95), rgba(255, 245, 223, 0.95));
            border: 1px solid rgba(107, 79, 53, 0.15);
            border-radius: 18px;
            box-shadow: 0 8px 30px rgba(66, 38, 17, 0.13);
            padding: 24px;
            margin-bottom: 16px;
        }

        .hero h1 {
            margin: 0 0 6px;
            color: var(--harvest-soil);
            font-weight: 700;
        }

        .hero p {
            margin: 0;
            color: #5e4938;
        }

        .grid {
            display: grid;
            grid-template-columns: repeat(12, 1fr);
            gap: 14px;
        }

        .card {
            background: var(--harvest-cream);
            border: 1px solid rgba(107, 79, 53, 0.16);
            border-radius: 14px;
            padding: 16px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.06);
        }

        .stat {
            grid-column: span 4;
        }

        .stat h3 {
            margin: 0;
            font-size: 1.8rem;
            color: var(--harvest-leaf);
        }

        .stat small {
            color: #6a5a48;
        }

        .two-col {
            grid-column: span 6;
        }

        .full {
            grid-column: span 12;
        }

        .btn-harvest {
            background: var(--harvest-leaf);
            border: none;
            color: white;
        }

        .btn-harvest:hover {
            background: #195a3c;
            color: white;
        }

        .status-pill {
            padding: 2px 8px;
            border-radius: 999px;
            font-size: 0.75rem;
            font-weight: 600;
        }

        .status-processed { background: #d7f3e4; color: #155b3b; }
        .status-needs_review { background: #ffe0d5; color: #7e2f14; }
        .status-reconciled { background: #dbe7ff; color: #1f3f86; }

        .table {
            --bs-table-bg: transparent;
            margin-bottom: 0;
        }

        .mono {
            font-family: Consolas, 'Courier New', monospace;
            font-size: 0.88rem;
        }

        .preview-row {
            display: none;
        }

        .preview-row td {
            background: #fff4dc;
            border-top: none;
        }

        .preview-label {
            font-size: 0.78rem;
            color: #6a5a48;
            text-transform: uppercase;
            letter-spacing: 0.04em;
            margin-right: 8px;
        }

        @media (max-width: 900px) {
            .stat, .two-col, .full {
                grid-column: span 12;
            }
        }
    </style>
</head>
<body>
    <main class="shell">
        <section class="hero">
            <h1>Harvest Procurement Console</h1>
            <p>Ingest vendor PO PDFs from Gmail or manual upload, extract data, and reconcile against receiving to prevent sellouts.</p>
            <div class="d-flex flex-wrap gap-2 mt-3">
                <% if (reviewDoc) { %>
                    <a class="btn btn-harvest" href="/harvest/document/<%= reviewDoc._id %>">Review Next Unconfirmed Document</a>
                <% } else { %>
                    <span class="badge bg-success-subtle text-success border border-success-subtle align-self-center">No unconfirmed documents right now</span>
                <% } %>
                <a class="btn btn-outline-secondary" href="/harvest/products">View All Products</a>
                <a class="btn btn-outline-secondary" href="/harvest/api/reconciliation-summary" target="_blank">Open JSON Summary</a>
            </div>
        </section>

        <section class="grid mb-3">
            <article class="card stat">
                <h3><%= stats.totalDocs || 0 %></h3>
                <small>Total Harvest Intake Documents</small>
            </article>
            <article class="card stat">
                <h3><%= stats.matchedDocs || 0 %></h3>
                <small>Matched to Existing Purchase Orders</small>
            </article>
            <article class="card stat">
                <h3><%= stats.needsReviewDocs || 0 %></h3>
                <small>Needs Review</small>
            </article>
            <article class="card stat">
                <h3><%= stats.totalUnconfirmedProducts || 0 %></h3>
                <small>Products Needing Confirmation</small>
            </article>
            <article class="card stat">
                <h3><%= stats.docsNeedingConfirmation || 0 %></h3>
                <small>Docs With Unconfirmed Products</small>
            </article>
        </section>

        <section class="grid mb-3">
            <article class="card two-col">
                <h5>Manual PDF Upload</h5>
                <form id="manualUploadForm" enctype="multipart/form-data">
                    <div class="mb-3">
                        <label class="form-label">Vendor PO PDF(s)</label>
                        <input type="file" class="form-control" name="pdfFile" accept="application/pdf,.pdf" multiple required>
                    </div>
                    <div class="form-check mb-3">
                        <input class="form-check-input" type="checkbox" id="manualAllowIncrement" name="allowIncrement" value="true">
                        <label class="form-check-label" for="manualAllowIncrement">
                            Upload as updated version (increment revision if this filename already exists)
                        </label>
                    </div>
                    <button class="btn btn-harvest" type="submit">Process PDF</button>
                </form>
                <div id="manualUploadResult" class="mt-3"></div>
            </article>

            <article class="card two-col">
                <h5>Gmail Attachment Intake</h5>
                <p class="mb-2">Use Gmail UID from the email-client inbox view. Harvest will ingest the first PDF attachment unless you specify one.</p>
                <form id="gmailIngestForm">
                    <div class="row g-2">
                        <div class="col-md-4">
                            <label class="form-label">Mailbox</label>
                            <input class="form-control" name="mailbox" value="INBOX">
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Email UID</label>
                            <input class="form-control" name="uid" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label">Attachment Name (optional)</label>
                            <input class="form-control" name="attachmentName" placeholder="PO-12345.pdf">
                        </div>
                    </div>
                    <div class="form-check mt-3">
                        <input class="form-check-input" type="checkbox" id="gmailAllowIncrement" name="allowIncrement" value="true">
                        <label class="form-check-label" for="gmailAllowIncrement">
                            Ingest as updated version when attachment filename already exists
                        </label>
                    </div>
                    <button class="btn btn-harvest mt-3" type="submit">Ingest from Gmail</button>
                </form>
                <div id="gmailIngestResult" class="mt-3"></div>
            </article>
        </section>

        <section class="grid mb-3">
            <article class="card two-col">
                <h5>Open SKU Risk Snapshot</h5>
                <% if (!openLineItemSummary || openLineItemSummary.length === 0) { %>
                    <p class="mb-0">No open SKU quantities found.</p>
                <% } else { %>
                    <div class="table-responsive">
                        <table class="table table-sm align-middle">
                            <thead>
                                <tr>
                                    <th>SKU</th>
                                    <th class="text-end">Open Qty</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% openLineItemSummary.forEach(row => { %>
                                    <tr>
                                        <td class="mono"><%= row._id %></td>
                                        <td class="text-end"><%= row.openQty %></td>
                                    </tr>
                                <% }); %>
                            </tbody>
                        </table>
                    </div>
                <% } %>
            </article>

            <article class="card two-col">
                <h5>Next Workflow Step</h5>
                <p>Phase 1 is now active: PDF intake and PO matching.</p>
                <p class="mb-2">Use the review button above to open the next document with unconfirmed items and compare it against the confirmed catalog.</p>
                <p class="mb-0">Phase 2 can connect sales (Shopify/POS export) to compute coverage days and reorder recommendations per SKU.</p>
            </article>
        </section>

        <section class="card full">
            <div class="d-flex justify-content-between align-items-center mb-2">
                <h5 class="mb-0">Recent Intake Documents</h5>
                <a class="btn btn-outline-secondary btn-sm" href="/harvest/api/reconciliation-summary" target="_blank">JSON Summary API</a>
            </div>
            <div class="table-responsive">
                <table class="table table-sm align-middle">
                    <thead>
                        <tr>
                            <th>Created</th>
                            <th>Source</th>
                            <th>File</th>
                            <th>PO Extracted</th>
                            <th>PO Matched</th>
                            <th>Confidence</th>
                            <th>Need Confirm</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        <% if (!docs || docs.length === 0) { %>
                            <tr><td colspan="9">No documents processed yet.</td></tr>
                        <% } %>
                        <% (docs || []).forEach(doc => { %>
                            <tr>
                                <td><%= new Date(doc.createdAt).toLocaleString() %></td>
                                <td><%= doc.sourceType %></td>
                                <td class="mono">
                                    <%= doc.file.originalName %>
                                    <span class="badge bg-secondary ms-1">v<%= (doc.file && doc.file.revisionNumber) ? doc.file.revisionNumber : 1 %></span>
                                    <% if (doc.isLatestRevision === false) { %>
                                        <span class="badge bg-light text-dark border ms-1">superseded</span>
                                    <% } %>
                                </td>
                                <td class="mono"><%= doc.extracted.poNumber || '-' %></td>
                                <td>
                                    <% if (doc.matchSummary && doc.matchSummary.purchaseOrderId) { %>
                                        <a href="/purchase-orders/<%= doc.matchSummary.purchaseOrderId._id %>"><%= doc.matchSummary.purchaseOrderNumber || 'Open PO' %></a>
                                    <% } else { %>
                                        -
                                    <% } %>
                                </td>
                                <td><%= Math.round((doc.extracted.confidence || 0) * 100) %>%</td>
                                <td>
                                    <% if ((doc.unconfirmedLineCount || 0) > 0) { %>
                                        <span class="badge bg-warning text-dark"><%= doc.unconfirmedLineCount %></span>
                                    <% } else { %>
                                        <span class="badge bg-success">0</span>
                                    <% } %>
                                </td>
                                <td>
                                    <span class="status-pill status-<%= doc.status %>"><%= doc.status %></span>
                                </td>
                                <td>
                                    <div class="d-flex gap-1">
                                        <a class="btn btn-outline-secondary btn-sm" href="/harvest/document/<%= doc._id %>">View</a>
                                        <button
                                            class="btn btn-outline-primary btn-sm"
                                            type="button"
                                            data-preview-toggle="preview-<%= doc._id %>">
                                            Preview
                                        </button>
                                        <button
                                            class="btn btn-outline-success btn-sm"
                                            type="button"
                                            data-reparse-id="<%= doc._id %>">
                                            Re-parse
                                        </button>
                                    </div>
                                </td>
                            </tr>
                            <tr id="preview-<%= doc._id %>" class="preview-row">
                                <td colspan="9">
                                    <div class="mb-2">
                                        <span class="preview-label">Ack #</span>
                                        <span class="mono"><%= doc.extracted.acknowledgementNumber || '-' %></span>
                                        <span class="preview-label ms-3">Order #</span>
                                        <span class="mono"><%= doc.extracted.orderNumber || '-' %></span>
                                        <span class="preview-label ms-3">Customer</span>
                                        <span><%= doc.extracted.customerName || '-' %></span>
                                    </div>
                                    <% if (!doc.extracted || !doc.extracted.lineItems || doc.extracted.lineItems.length === 0) { %>
                                        <div class="text-muted">No extracted line items for this document.</div>
                                    <% } else { %>
                                        <div class="table-responsive">
                                            <table class="table table-sm align-middle mb-0">
                                                <thead>
                                                    <tr>
                                                        <th>Line #</th>
                                                        <th>Product</th>
                                                        <th>UPC</th>
                                                        <th>Description</th>
                                                        <th class="text-end">Qty Ordered</th>
                                                        <th class="text-end">Qty Received</th>
                                                        <th>Qty U/M</th>
                                                        <th class="text-end">Retail</th>
                                                        <th class="text-end">Unit</th>
                                                        <th class="text-end">Extended</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% doc.extracted.lineItems.forEach(item => { %>
                                                        <tr>
                                                            <td><%= item.lineNumber !== null && item.lineNumber !== undefined ? item.lineNumber : '-' %></td>
                                                            <td class="mono"><%= item.sku || '-' %></td>
                                                            <td class="mono"><%= item.upc || '-' %></td>
                                                            <td><%= item.description || '-' %></td>
                                                            <td class="text-end"><%= item.quantity !== null && item.quantity !== undefined ? item.quantity : '-' %></td>
                                                            <td class="text-end"><%= item.quantityReceived !== null && item.quantityReceived !== undefined ? item.quantityReceived : '-' %></td>
                                                            <td><%= item.qtyUom || '-' %></td>
                                                            <td class="text-end"><%= item.retailPrice !== null && item.retailPrice !== undefined ? item.retailPrice : '-' %></td>
                                                            <td class="text-end"><%= item.unitPrice !== null && item.unitPrice !== undefined ? item.unitPrice : '-' %></td>
                                                            <td class="text-end"><%= item.amount !== null && item.amount !== undefined ? item.amount : '-' %></td>
                                                        </tr>
                                                    <% }); %>
                                                </tbody>
                                            </table>
                                        </div>
                                    <% } %>
                                </td>
                            </tr>
                        <% }); %>
                    </tbody>
                </table>
            </div>
        </section>
    </main>

    <script>
        const manualUploadForm = document.getElementById('manualUploadForm');
        const manualUploadResult = document.getElementById('manualUploadResult');
        const gmailIngestForm = document.getElementById('gmailIngestForm');
        const gmailIngestResult = document.getElementById('gmailIngestResult');

        document.querySelectorAll('[data-preview-toggle]').forEach((button) => {
            button.addEventListener('click', () => {
                const targetId = button.getAttribute('data-preview-toggle');
                const row = document.getElementById(targetId);
                if (!row) return;

                const isOpen = row.style.display === 'table-row';
                row.style.display = isOpen ? 'none' : 'table-row';
                button.textContent = isOpen ? 'Preview' : 'Hide';
            });
        });

        document.querySelectorAll('[data-reparse-id]').forEach((button) => {
            button.addEventListener('click', async () => {
                const documentId = button.getAttribute('data-reparse-id');
                if (!documentId) return;

                const previousText = button.textContent;
                button.disabled = true;
                button.textContent = 'Re-parsing...';

                try {
                    const response = await fetch(`/harvest/document/${encodeURIComponent(documentId)}/reparse`, {
                        method: 'POST',
                        headers: {
                            'Content-Type': 'application/json',
                            'Accept': 'application/json',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    const contentType = (response.headers.get('content-type') || '').toLowerCase();
                    let result;

                    if (contentType.includes('application/json')) {
                        result = await response.json();
                    } else {
                        const text = await response.text();
                        if (response.status === 401 || text.includes('Login - Purchase Order System')) {
                            throw new Error('Your session expired. Please sign in again, then re-parse.');
                        }
                        throw new Error('Unexpected server response while re-parsing document.');
                    }

                    if (!response.ok || !result.success) {
                        throw new Error(result.error || 'Failed to re-parse document');
                    }

                    // Show results before reloading
                    const extracted = result.extracted || {};
                    const dataQuality = extracted.dataQuality || {};
                    const alertMsg = `Re-parse complete!\n\n` +
                        `PO: ${extracted.poNumber || 'N/A'}\n` +
                        `Ack: ${extracted.acknowledgementNumber || 'N/A'}\n` +
                        `Line Items: ${extracted.lineItemCount}\n\n` +
                        `Data Quality:\n` +
                        `✓ Qty Ordered: ${dataQuality.itemsWithQtyOrdered}/${extracted.lineItemCount}\n` +
                        `✓ Qty Received: ${dataQuality.itemsWithQtyReceived}/${extracted.lineItemCount}\n` +
                        `✓ Extended Amt: ${dataQuality.itemsWithAmount}/${extracted.lineItemCount}\n` +
                        `✓ Unit Price: ${dataQuality.itemsWithPrice}/${extracted.lineItemCount}`;
                    
                    alert(alertMsg);
                    window.location.reload();
                } catch (error) {
                    alert(error.message);
                    button.disabled = false;
                    button.textContent = previousText;
                }
            });
        });

        manualUploadForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            manualUploadResult.textContent = 'Processing PDF file(s)...';

            const formData = new FormData(manualUploadForm);
            formData.set('allowIncrement', manualUploadForm.allowIncrement.checked ? 'true' : 'false');

            try {
                const response = await fetch('/harvest/upload-pdf', {
                    method: 'POST',
                    body: formData
                });

                const result = await response.json();
                if (!response.ok || !result.success) {
                    if (result && result.duplicate && result.existingDocumentId && !Array.isArray(result.errors)) {
                        const revisionLabel = result.existingRevisionNumber ? `v${result.existingRevisionNumber}` : 'existing';
                        manualUploadResult.innerHTML = `<div class="alert alert-warning mb-0">${result.error}<br><a href="/harvest/document/${encodeURIComponent(result.existingDocumentId)}">View ${revisionLabel} document</a></div>`;
                        return;
                    }
                    if (result && Array.isArray(result.errors) && result.errors.length > 0) {
                        const lines = result.errors.slice(0, 5).map(row => {
                            if (row.duplicate && row.existingDocumentId) {
                                return `${row.fileName}: duplicate (<a href="/harvest/document/${encodeURIComponent(row.existingDocumentId)}">view existing</a>)`;
                            }
                            return `${row.fileName}: ${row.error || 'failed'}`;
                        });
                        manualUploadResult.innerHTML = `<div class="alert alert-danger mb-0">${result.message || 'Upload failed'}<br>${lines.join('<br>')}</div>`;
                        return;
                    }
                    throw new Error(result.error || 'Failed to process PDF');
                }

                if (Array.isArray(result.documents) && result.documents.length > 1) {
                    const duplicateNote = result.duplicateCount > 0 ? `<br>Duplicates skipped: <strong>${result.duplicateCount}</strong>` : '';
                    manualUploadResult.innerHTML = `<div class="alert alert-success mb-0">${result.message}<br>Processed: <strong>${result.processedCount}</strong> | Failed: <strong>${result.failedCount}</strong>${duplicateNote}</div>`;
                } else {
                    manualUploadResult.innerHTML = `<div class="alert alert-success mb-0">${result.message}<br>Extracted PO: <strong>${result.extracted.poNumber || 'N/A'}</strong> | Matched PO: <strong>${result.matchedPo || 'None'}</strong></div>`;
                }
                setTimeout(() => window.location.reload(), 1000);
            } catch (error) {
                manualUploadResult.innerHTML = `<div class="alert alert-danger mb-0">${error.message}</div>`;
            }
        });

        gmailIngestForm.addEventListener('submit', async (event) => {
            event.preventDefault();
            gmailIngestResult.textContent = 'Ingesting Gmail attachment...';

            const mailbox = gmailIngestForm.mailbox.value || 'INBOX';
            const uid = gmailIngestForm.uid.value;
            const attachmentName = gmailIngestForm.attachmentName.value;
            const allowIncrement = Boolean(gmailIngestForm.allowIncrement.checked);

            try {
                const response = await fetch(`/harvest/ingest-gmail/${encodeURIComponent(uid)}`, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ mailbox, attachmentName, allowIncrement })
                });

                const result = await response.json();
                if (!response.ok || !result.success) {
                    if (result && result.duplicate && result.existingDocumentId) {
                        const revisionLabel = result.existingRevisionNumber ? `v${result.existingRevisionNumber}` : 'existing';
                        gmailIngestResult.innerHTML = `<div class="alert alert-warning mb-0">${result.error}<br><a href="/harvest/document/${encodeURIComponent(result.existingDocumentId)}">View ${revisionLabel} document</a></div>`;
                        return;
                    }
                    throw new Error(result.error || 'Failed to ingest Gmail attachment');
                }

                gmailIngestResult.innerHTML = `<div class="alert alert-success mb-0">${result.message}<br>Extracted PO: <strong>${result.extractedPoNumber || 'N/A'}</strong> | Matched PO: <strong>${result.matchedPo || 'None'}</strong></div>`;
                setTimeout(() => window.location.reload(), 1000);
            } catch (error) {
                gmailIngestResult.innerHTML = `<div class="alert alert-danger mb-0">${error.message}</div>`;
            }
        });
    </script>
</body>
</html>
